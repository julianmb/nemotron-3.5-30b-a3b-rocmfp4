From 66961c10b9f0498af997cfd8babe2501be50b7a7 Mon Sep 17 00:00:00 2001
From: julianmb <julianmb@users.noreply.github.com>
Date: Wed, 12 Aug 2026 14:36:51 +1000
Subject: [PATCH 1/2] convert_hf_to_gguf: match W4A16_NVFP4 tag in ModelOpt
 checkpoints

Some ModelOpt NVFP4 checkpoints tag per-layer quant_algo as W4A16_NVFP4
(e.g., NVIDIA Nemotron 3.5 Lightning 30B-A3B NVFP4) instead of exact NVFP4.
Matching substring NVFP4 ensures _is_nvfp4 gets set so _generate_nvfp4_tensors
runs, rather than falling through to dequant_simple.
---
 convert_hf_to_gguf.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/convert_hf_to_gguf.py b/convert_hf_to_gguf.py
index 421716f..283e305 100755
--- a/convert_hf_to_gguf.py
+++ b/convert_hf_to_gguf.py
@@ -793,8 +793,10 @@ class ModelBase:
 
         # Some models use per-tensor quant_algo (e.g. "MIXED_PRECISION" with
         # per-layer NVFP4/FP8) instead of a single global "NVFP4" value.
+        # NVFP4 tensors can be tagged "W4A16_NVFP4" (ModelOpt), so match the
+        # substring rather than the exact value.
         if quant_algo != "NVFP4":
-            if any(v.get("quant_algo") == "NVFP4" for v in quant_layers.values() if isinstance(v, dict)):
+            if any("NVFP4" in str(v.get("quant_algo", "")) for v in quant_layers.values() if isinstance(v, dict)):
                 quant_algo = "NVFP4"
 
         self._is_nvfp4 = quant_algo == "NVFP4"
