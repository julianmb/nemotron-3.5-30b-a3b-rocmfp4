From bb19c833352491fdc64355fb8eb6f0acc837e799 Mon Sep 17 00:00:00 2001
From: julianmb <julianmb@users.noreply.github.com>
Date: Wed, 12 Aug 2026 14:36:51 +1000
Subject: [PATCH 2/2] convert_hf_to_gguf: dequantize NVFP4 output.weight to F16

When a ModelOpt NVFP4 checkpoint quantizes output.weight, repacking it
emits output.scale (scale2 factor). llama.cpp has no output-scale tensor
counterpart in the runtime mapping, causing done_getting_tensors to abort
with 'wrong number of tensors; expected N, got N-1'.

Dequantize output.weight to F16 in-place using signed-E2M1 fp4 lookup table
(low-nibble first, per-16 E4M3 scale, times scale2) so no output.scale is emitted.
---
 convert_hf_to_gguf.py | 41 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 40 insertions(+), 1 deletion(-)

diff --git a/convert_hf_to_gguf.py b/convert_hf_to_gguf.py
index 283e305..7ef0a17 100755
--- a/convert_hf_to_gguf.py
+++ b/convert_hf_to_gguf.py
@@ -666,6 +666,36 @@ class ModelBase:
         raw = np.concatenate([d_grouped, qs_grouped], axis=-1).reshape(out_features, n_super * 36)
         return raw, [out_features, n_super * 64]
 
+    @staticmethod
+    def _nvfp4_dequant_to_f16(weight: Tensor, scale: Tensor, scale2: Tensor, input_scale: Tensor) -> Tensor:
+        """Dequantize a ModelOpt NVFP4 packed tensor back to F16.
+
+        Used for tensors that the GGUF runtime expects at high precision (e.g.
+        output.weight), where a packed NVFP4 tensor plus an auxiliary per-tensor
+        scale has no tensor-mapping counterpart in llama.cpp.
+
+        Empirically verified against the source BF16 checkpoint: the packed data
+        is signed E2M1 fp4, low nibble first, one E4M3 scale per 16-element
+        group, times the per-tensor scale2 and input_scale factors. F16 (not
+        BF16) is used because the dequantized values carry only fp4 precision
+        and numpy in this environment lacks bfloat16 support.
+        """
+        out_features = weight.shape[0]
+        n_blocks = scale.shape[1]
+
+        # Unpack ModelOpt nibble-packed weights (same layout as _nvfp4_pack)
+        w = weight.reshape(out_features, n_blocks, 8)
+        vals = torch.stack([w & 0x0F, w >> 4], dim=-1).reshape(out_features, n_blocks, 16)
+
+        # Signed E2M1 (fp4) lookup: exponent (n >> 1) & 3, mantissa n & 1,
+        # sign bit n & 8, exponent bias 1.
+        tab = torch.tensor(
+            [0, 0.5, 1, 1.5, 2, 3, 4, 6, 0, -0.5, -1, -1.5, -2, -3, -4, -6],
+            dtype=torch.float32,
+        )
+        dequant = tab[vals.long()] * scale.float().unsqueeze(-1) * scale2.float() * input_scale.float()
+        return dequant.reshape(out_features, n_blocks * 16).to(torch.float16)
+
     def _repack_nvfp4(self, name: str, weight: Tensor, scale: Tensor, scale2: Tensor, input_scale: Tensor):
         new_name = self.map_tensor_name(name)
 
@@ -737,7 +767,16 @@ class ModelBase:
                 if n_experts > 0 and len(expert_blocks[key]) >= n_experts:
                     self._flush_nvfp4_experts(key, expert_blocks, expert_scales, expert_input_scales, expert_shapes, bid, proj_type)
             else:
-                self._repack_nvfp4(name, weight, scale, scale2, input_scale)
+                # The GGUF output tensor has no auxiliary scale-tensor counterpart
+                # in the runtime, so a packed NVFP4 output (which needs output.scale)
+                # makes the resulting GGUF unloadable. Dequantize it to F16 instead.
+                new_name = self.map_tensor_name(name)
+                if new_name == self.format_tensor_name(gguf.MODEL_TENSOR.OUTPUT):
+                    dequant = self._nvfp4_dequant_to_f16(weight, scale, scale2, input_scale)
+                    logger.info(f"Dequantized {new_name} to F16 (no NVFP4 output scale)")
+                    self.gguf_writer.add_tensor(new_name, dequant.numpy(), raw_dtype=gguf.GGMLQuantizationType.F16)
+                else:
+                    self._repack_nvfp4(name, weight, scale, scale2, input_scale)
 
         # Flush any remaining experts (fallback if n_experts was unknown)
         for bid, proj_type in list(expert_blocks.keys()):
