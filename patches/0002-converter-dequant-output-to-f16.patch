+    @staticmethod
+    def _nvfp4_dequant_to_f16(weight: Tensor, scale: Tensor, scale2: Tensor, input_scale: Tensor) -> Tensor:
+        """Dequantize a ModelOpt NVFP4 packed tensor back to F16.
+
+        Used for tensors that the GGUF runtime expects at high precision (e.g.
+        output.weight), where a packed NVFP4 tensor plus an auxiliary per-tensor
+        scale has no tensor-mapping counterpart in llama.cpp.
+
+        Empirically verified against the source BF16 checkpoint: the packed data
+        is signed E2M1 fp4, low nibble first, one E4M3 scale per 16-element
+        group, times the per-tensor scale2 and input_scale factors. F16 (not
+        BF16) is used because the dequantized values carry only fp4 precision
+        and numpy in this environment lacks bfloat16 support.
+        """
+        out_features = weight.shape[0]
+        n_blocks = scale.shape[1]
+
+        # Unpack ModelOpt nibble-packed weights (same layout as _nvfp4_pack)
+        w = weight.reshape(out_features, n_blocks, 8)
+        vals = torch.stack([w & 0x0F, w >> 4], dim=-1).reshape(out_features, n_blocks, 16)
+
+        # Signed E2M1 (fp4) lookup: exponent (n >> 1) & 3, mantissa n & 1,
+        # sign bit n & 8, exponent bias 1.
+        tab = torch.tensor(
+            [0, 0.5, 1, 1.5, 2, 3, 4, 6, 0, -0.5, -1, -1.5, -2, -3, -4, -6],
+            dtype=torch.float32,
+        )
+        dequant = tab[vals.long()] * scale.float().unsqueeze(-1) * scale2.float() * input_scale.float()
+        return dequant.reshape(out_features, n_blocks * 16).to(torch.float16)
+
